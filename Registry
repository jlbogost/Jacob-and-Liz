<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jacob & Liz — Registry</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root {
    --cream: #faf6f1;
    --warm-white: #fff9f4;
    --blush: #e8c4b0;
    --dusty-rose: #c9896e;
    --terracotta: #a85f45;
    --dark: #2a1f1a;
    --mid: #6b4f43;
    --light-mid: #b8957f;
    --sage: #8fa68c;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: var(--cream); color: var(--dark); font-family: 'Jost', sans-serif; font-weight: 300; min-height: 100vh; }

  /* HEADER */
  header { background: var(--warm-white); text-align: center; padding: 60px 20px 50px; position: relative; overflow: hidden; border-bottom: 1px solid #e8d8cc; }
  header::before { content: ''; position: absolute; top: -60px; left: 50%; transform: translateX(-50%); width: 400px; height: 400px; background: radial-gradient(circle, rgba(232,196,176,0.3) 0%, transparent 70%); border-radius: 50%; pointer-events: none; }
  .couple-name { font-family: 'Cormorant Garamond', serif; font-size: clamp(2.8rem, 7vw, 5rem); font-weight: 300; letter-spacing: 0.04em; color: var(--dark); line-height: 1; }
  .couple-name span { font-style: italic; color: var(--terracotta); }
  .wedding-date { font-family: 'Jost', sans-serif; font-size: 0.78rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--light-mid); margin-top: 14px; }
  .divider { width: 60px; height: 1px; background: var(--blush); margin: 20px auto; }
  .header-note { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.1rem; color: var(--mid); max-width: 420px; margin: 0 auto; line-height: 1.7; }

  /* ADMIN BAR */
  .admin-bar { background: var(--dark); color: #c9a96e; text-align: center; padding: 10px; font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; cursor: pointer; transition: background 0.2s; user-select: none; }
  .admin-bar:hover { background: #3d2d26; }

  /* MAIN */
  main { max-width: 1100px; margin: 0 auto; padding: 50px 24px 80px; }

  /* TABS */
  .tabs { display: flex; border-bottom: 1px solid #e0cfc7; margin-bottom: 44px; }
  .tab { font-family: 'Jost', sans-serif; font-size: 0.78rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--light-mid); padding: 12px 28px; cursor: pointer; border-bottom: 2px solid transparent; transition: all 0.2s; background: none; border-top: none; border-left: none; border-right: none; }
  .tab:hover { color: var(--terracotta); }
  .tab.active { color: var(--terracotta); border-bottom: 2px solid var(--terracotta); }

  /* ADMIN PANEL */
  #admin-panel { display: none; background: var(--warm-white); border: 1px solid #e0cfc7; border-radius: 12px; padding: 32px; margin-bottom: 48px; }
  #admin-panel h3 { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 400; margin-bottom: 24px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-grid .full { grid-column: 1 / -1; }
  input, select, textarea { width: 100%; padding: 12px 16px; border: 1px solid #ddd0c8; border-radius: 6px; font-family: 'Jost', sans-serif; font-size: 0.9rem; font-weight: 300; background: white; color: var(--dark); transition: border 0.2s; outline: none; }
  input:focus, select:focus, textarea:focus { border-color: var(--dusty-rose); }
  input::placeholder, textarea::placeholder { color: #bbb; }
  label { display: block; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--light-mid); margin-bottom: 6px; }
  .btn { padding: 13px 30px; border: none; border-radius: 6px; font-family: 'Jost', sans-serif; font-size: 0.78rem; letter-spacing: 0.15em; text-transform: uppercase; cursor: pointer; transition: all 0.2s; }
  .btn-primary { background: var(--terracotta); color: white; }
  .btn-primary:hover { background: var(--dark); }
  .btn-secondary { background: transparent; color: var(--mid); border: 1px solid #ddd0c8; }
  .btn-secondary:hover { border-color: var(--terracotta); color: var(--terracotta); }

  /* CASH FUNDS */
  .cash-section h2, .gifts-section h2 { font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; font-weight: 300; color: var(--dark); margin-bottom: 6px; }
  .section-subtitle { font-size: 0.82rem; color: var(--light-mid); letter-spacing: 0.06em; margin-bottom: 24px; }
  .cash-funds-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
  .cash-card { background: var(--warm-white); border: 1px solid #e8d8cc; border-radius: 12px; padding: 28px 24px; position: relative; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; }
  .cash-card:hover { transform: translateY(-3px); box-shadow: 0 8px 30px rgba(42,31,26,0.08); }
  .cash-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--blush), var(--dusty-rose)); }
  .cash-icon { font-size: 2rem; margin-bottom: 12px; }
  .cash-card h4 { font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; font-weight: 400; margin-bottom: 6px; }
  .cash-card p { font-size: 0.84rem; color: var(--mid); line-height: 1.6; margin-bottom: 20px; }
  .cash-goal { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--light-mid); margin-bottom: 8px; }
  .progress-bar { width: 100%; height: 4px; background: #ecddd6; border-radius: 2px; overflow: hidden; margin-bottom: 16px; }
  .progress-fill { height: 100%; background: linear-gradient(90deg, var(--blush), var(--terracotta)); border-radius: 2px; }

  /* GIFTS */
  .filter-row { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 28px; margin-top: 18px; }
  .filter-btn { padding: 7px 18px; border: 1px solid #ddd0c8; border-radius: 20px; font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mid); cursor: pointer; background: none; transition: all 0.2s; }
  .filter-btn:hover, .filter-btn.active { background: var(--terracotta); border-color: var(--terracotta); color: white; }
  .gifts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; }
  .gift-card { background: white; border: 1px solid #ecddd6; border-radius: 12px; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; position: relative; }
  .gift-card:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(42,31,26,0.1); }
  .gift-card.purchased { opacity: 0.55; }
  .gift-card.purchased::after { content: '✓ Claimed'; position: absolute; top: 12px; right: 12px; background: var(--sage); color: white; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 5px 10px; border-radius: 20px; }
  .gift-img { width: 100%; height: 200px; background: #f0e7e0; display: flex; align-items: center; justify-content: center; font-size: 3rem; color: var(--blush); overflow: hidden; }
  .gift-img img { width: 100%; height: 100%; object-fit: cover; }
  .gift-body { padding: 20px; }
  .gift-store { font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--light-mid); margin-bottom: 5px; }
  .gift-name { font-family: 'Cormorant Garamond', serif; font-size: 1.2rem; font-weight: 400; color: var(--dark); margin-bottom: 6px; }
  .gift-note { font-size: 0.82rem; color: var(--mid); line-height: 1.5; margin-bottom: 14px; font-style: italic; }
  .gift-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .gift-price { font-family: 'Cormorant Garamond', serif; font-size: 1.2rem; color: var(--terracotta); }
  .gift-actions { display: flex; gap: 8px; }
  .btn-claim { padding: 8px 16px; background: var(--terracotta); color: white; border: none; border-radius: 5px; font-family: 'Jost', sans-serif; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: background 0.2s; }
  .btn-claim:hover { background: var(--dark); }
  .btn-link { padding: 8px 12px; background: transparent; color: var(--mid); border: 1px solid #ddd0c8; border-radius: 5px; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; cursor: pointer; transition: all 0.2s; text-decoration: none; display: inline-flex; align-items: center; }
  .btn-link:hover { border-color: var(--terracotta); color: var(--terracotta); }
  .btn-delete { padding: 8px 10px; background: transparent; color: #ccc; border: 1px solid #eee; border-radius: 5px; font-size: 0.72rem; cursor: pointer; transition: all 0.2s; }
  .btn-delete:hover { border-color: #e07070; color: #e07070; }

  /* MODAL */
  .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(42,31,26,0.5); backdrop-filter: blur(3px); z-index: 100; align-items: center; justify-content: center; }
  .modal-overlay.open { display: flex; }
  .modal { background: white; border-radius: 16px; padding: 40px; max-width: 420px; width: 90%; animation: slideUp 0.3s ease; text-align: center; }
  .modal h3 { font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; font-weight: 300; margin-bottom: 10px; }
  .modal p { font-size: 0.88rem; color: var(--mid); line-height: 1.6; margin-bottom: 24px; }
  .modal-actions { display: flex; gap: 12px; justify-content: center; }

  /* SETTINGS MODAL */
  .settings-overlay { display: none; position: fixed; inset: 0; background: rgba(42,31,26,0.5); backdrop-filter: blur(3px); z-index: 200; align-items: center; justify-content: center; }
  .settings-overlay.open { display: flex; }
  .settings-modal { background: white; border-radius: 16px; padding: 40px; max-width: 480px; width: 90%; animation: slideUp 0.3s ease; }
  .settings-modal h3 { font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; margin-bottom: 24px; }

  /* LOADING */
  .loading { text-align: center; padding: 60px; color: var(--light-mid); font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.2rem; }
  .empty-state { text-align: center; padding: 60px 20px; color: var(--light-mid); grid-column: 1/-1; }
  .empty-state .empty-icon { font-size: 3rem; margin-bottom: 16px; }
  .empty-state p { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 1.2rem; }

  /* TOAST */
  .toast { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); background: var(--dark); color: white; padding: 14px 28px; border-radius: 8px; font-size: 0.82rem; letter-spacing: 0.08em; z-index: 999; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
  .toast.show { opacity: 1; }

  @keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 600px) { .form-grid { grid-template-columns: 1fr; } .form-grid .full { grid-column: 1; } }
</style>
</head>
<body>

<header>
  <div class="couple-name">Jacob &amp; <span>Liz</span></div>
  <div class="wedding-date" id="display-wedding-date">Loading...</div>
  <div class="divider"></div>
  <p class="header-note" id="display-header-note">Loading...</p>
</header>

<div class="admin-bar" onclick="toggleAdmin()">⚙ Manage Registry</div>

<!-- ADMIN PANEL -->
<div id="admin-panel">
  <div id="admin-auth-section">
    <h3>Enter Admin Password</h3>
    <div style="max-width:300px">
      <label>Password</label>
      <input type="password" id="admin-password-input" placeholder="Enter password" onkeydown="if(event.key==='Enter') checkPassword()">
      <div style="margin-top:12px; display:flex; gap:10px;">
        <button class="btn btn-primary" onclick="checkPassword()">Unlock</button>
        <button class="btn btn-secondary" onclick="toggleAdmin()">Cancel</button>
      </div>
      <p style="font-size:0.75rem; color:#bbb; margin-top:10px;">Default password: <strong>wedding2026</strong></p>
    </div>
  </div>

  <div id="admin-content" style="display:none">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
      <h3>Add to Registry</h3>
      <button class="btn btn-secondary" onclick="openSettings()">✦ Edit Page Info</button>
    </div>
    <div style="display:flex; gap:16px; margin-bottom:24px;">
      <button class="btn btn-primary" onclick="showAddTab('gift')">+ Gift Item</button>
      <button class="btn btn-secondary" onclick="showAddTab('fund')">+ Cash Fund</button>
    </div>

    <!-- Gift Form -->
    <div id="add-gift-form">
      <div class="form-grid">
        <div class="full"><label>Item Name</label><input type="text" id="gift-name" placeholder="e.g. Le Creuset Dutch Oven"></div>
        <div><label>Store / Retailer</label><input type="text" id="gift-store" placeholder="e.g. Williams Sonoma"></div>
        <div><label>Price</label><input type="text" id="gift-price" placeholder="e.g. $120"></div>
        <div class="full"><label>Product URL</label><input type="url" id="gift-url" placeholder="https://..."></div>
        <div class="full"><label>Image URL (optional)</label><input type="url" id="gift-image" placeholder="https://..."></div>
        <div><label>Category</label>
          <select id="gift-category">
            <option>Home</option><option>Kitchen</option><option>Bedroom</option>
            <option>Bathroom</option><option>Entertainment</option><option>Travel</option><option>Other</option>
          </select>
        </div>
        <div><label>Quantity Needed</label><input type="number" id="gift-qty" value="1" min="1"></div>
        <div class="full"><label>Personal Note (optional)</label><textarea id="gift-note" rows="2" placeholder="Why you love this item..."></textarea></div>
      </div>
      <div style="margin-top:20px;"><button class="btn btn-primary" onclick="addGift()">Add Item</button></div>
    </div>

    <!-- Fund Form -->
    <div id="add-fund-form" style="display:none">
      <div class="form-grid">
        <div><label>Fund Name</label><input type="text" id="fund-name" placeholder="e.g. Honeymoon Fund"></div>
        <div><label>Goal Amount ($)</label><input type="number" id="fund-goal" placeholder="e.g. 2000"></div>
        <div class="full"><label>Description</label><textarea id="fund-desc" rows="2" placeholder="Tell your guests about this fund..."></textarea></div>
        <div><label>Emoji Icon</label><input type="text" id="fund-icon" placeholder="🌴" maxlength="2"></div>
        <div><label>Payment Link (Venmo, PayPal, etc.)</label><input type="url" id="fund-link" placeholder="https://venmo.com/..."></div>
      </div>
      <div style="margin-top:20px;"><button class="btn btn-primary" onclick="addFund()">Add Fund</button></div>
    </div>

    <div style="margin-top:16px; border-top:1px solid #eee; padding-top:16px;">
      <button class="btn btn-secondary" style="font-size:0.72rem;" onclick="lockAdmin()">🔒 Lock Admin</button>
    </div>
  </div>
</div>

<!-- SETTINGS MODAL -->
<div class="settings-overlay" id="settings-overlay">
  <div class="settings-modal">
    <h3>Page Settings</h3>
    <div class="form-grid">
      <div class="full"><label>Date & Location</label><input type="text" id="setting-date" placeholder="June 14, 2026 · Newport, Rhode Island"></div>
      <div class="full"><label>Header Note</label><textarea id="setting-note" rows="3"></textarea></div>
      <div class="full"><label>Admin Password</label><input type="password" id="setting-password" placeholder="Change password (leave blank to keep)"></div>
    </div>
    <div style="display:flex; gap:12px; margin-top:20px;">
      <button class="btn btn-primary" onclick="saveSettings()">Save</button>
      <button class="btn btn-secondary" onclick="closeSettings()">Cancel</button>
    </div>
  </div>
</div>

<main>
  <div class="tabs">
    <button class="tab active" onclick="switchTab('gifts')">Gift Registry</button>
    <button class="tab" onclick="switchTab('funds')">Cash Funds</button>
  </div>

  <div id="tab-gifts">
    <div class="gifts-section">
      <h2>Our Wish List</h2>
      <p class="section-subtitle">Click any item to purchase — it will be marked as claimed for other guests.</p>
      <div class="filter-row" id="filter-row"><button class="filter-btn active" onclick="filterGifts('All', this)">All</button></div>
      <div class="gifts-grid" id="gifts-grid"><div class="loading">Loading gifts...</div></div>
    </div>
  </div>

  <div id="tab-funds" style="display:none">
    <div class="cash-section">
      <h2>Cash Funds</h2>
      <p class="section-subtitle">Contributions go directly to us via the links below.</p>
      <div class="cash-funds-grid" id="cash-funds-grid"><div class="loading">Loading funds...</div></div>
    </div>
  </div>
</main>

<!-- CLAIM MODAL -->
<div class="modal-overlay" id="claim-modal">
  <div class="modal">
    <div style="font-size:2rem; margin-bottom:12px;">🎁</div>
    <h3>Claim this Gift?</h3>
    <p id="claim-modal-text"></p>
    <div class="modal-actions">
      <button class="btn btn-primary" onclick="confirmClaim()">Yes, I'll get this!</button>
      <button class="btn btn-secondary" onclick="closeClaimModal()">Cancel</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
// ─── SUPABASE SETUP ───────────────────────────────────────────────────────────
const SUPABASE_URL = 'https://cdrirtmosuhzoovilugb.supabase.co';
const SUPABASE_KEY = 'sb_publishable_SdVwnCnkqG4po35RpIOYyw_5EOvp__p';
const { createClient } = supabase;
const db = createClient(SUPABASE_URL, SUPABASE_KEY);

// ─── STATE ────────────────────────────────────────────────────────────────────
let adminUnlocked = false;
let claimingId = null;
let currentFilter = 'All';
let allGifts = [];
let adminPassword = 'wedding2026';

// ─── INIT ─────────────────────────────────────────────────────────────────────
async function init() {
  await loadSettings();
  await loadGifts();
  await loadFunds();
}

// ─── SETTINGS ─────────────────────────────────────────────────────────────────
async function loadSettings() {
  const { data } = await db.from('settings').select('*').limit(1);
  if (data && data.length > 0) {
    const s = data[0];
    document.getElementById('display-wedding-date').textContent = s.wedding_date || '';
    document.getElementById('display-header-note').textContent = s.header_note || '';
    if (s.password) adminPassword = s.password;
  } else {
    // Insert defaults
    await db.from('settings').insert({
      wedding_date: 'Add your date & location in settings',
      header_note: "Your presence at our wedding is the greatest gift of all. For those who've asked, we've put together a few wishes below.",
      password: 'wedding2026'
    });
    document.getElementById('display-wedding-date').textContent = 'Add your date & location in settings';
    document.getElementById('display-header-note').textContent = "Your presence at our wedding is the greatest gift of all. For those who've asked, we've put together a few wishes below.";
  }
}

function openSettings() {
  document.getElementById('setting-date').value = document.getElementById('display-wedding-date').textContent;
  document.getElementById('setting-note').value = document.getElementById('display-header-note').textContent;
  document.getElementById('setting-password').value = '';
  document.getElementById('settings-overlay').classList.add('open');
}

function closeSettings() {
  document.getElementById('settings-overlay').classList.remove('open');
}

async function saveSettings() {
  const wedding_date = document.getElementById('setting-date').value;
  const header_note = document.getElementById('setting-note').value;
  const newPass = document.getElementById('setting-password').value;

  const updates = { wedding_date, header_note };
  if (newPass) { updates.password = newPass; adminPassword = newPass; }

  // Get existing row id
  const { data } = await db.from('settings').select('id').limit(1);
  if (data && data.length > 0) {
    await db.from('settings').update(updates).eq('id', data[0].id);
  } else {
    await db.from('settings').insert(updates);
  }

  document.getElementById('display-wedding-date').textContent = wedding_date;
  document.getElementById('display-header-note').textContent = header_note;
  closeSettings();
  showToast('Settings saved!');
}

// ─── ADMIN ────────────────────────────────────────────────────────────────────
function toggleAdmin() {
  const panel = document.getElementById('admin-panel');
  const isOpen = panel.style.display === 'block';
  panel.style.display = isOpen ? 'none' : 'block';
  if (!isOpen && !adminUnlocked) {
    document.getElementById('admin-auth-section').style.display = '';
    document.getElementById('admin-content').style.display = 'none';
  }
}

function checkPassword() {
  const input = document.getElementById('admin-password-input').value;
  if (input === adminPassword) {
    adminUnlocked = true;
    document.getElementById('admin-auth-section').style.display = 'none';
    document.getElementById('admin-content').style.display = '';
    renderGifts();
    renderFunds();
  } else {
    document.getElementById('admin-password-input').style.borderColor = '#e07070';
    document.getElementById('admin-password-input').value = '';
    document.getElementById('admin-password-input').placeholder = 'Incorrect password';
  }
}

function lockAdmin() {
  adminUnlocked = false;
  document.getElementById('admin-panel').style.display = 'none';
  renderGifts();
  renderFunds();
}

function showAddTab(tab) {
  document.getElementById('add-gift-form').style.display = tab === 'gift' ? '' : 'none';
  document.getElementById('add-fund-form').style.display = tab === 'fund' ? '' : 'none';
}

// ─── TABS ─────────────────────────────────────────────────────────────────────
function switchTab(tab) {
  document.getElementById('tab-gifts').style.display = tab === 'gifts' ? '' : 'none';
  document.getElementById('tab-funds').style.display = tab === 'funds' ? '' : 'none';
  document.querySelectorAll('.tab').forEach((t, i) => {
    t.classList.toggle('active', (i === 0 && tab === 'gifts') || (i === 1 && tab === 'funds'));
  });
}

// ─── GIFTS ────────────────────────────────────────────────────────────────────
async function loadGifts() {
  const { data, error } = await db.from('gifts').select('*').order('created_at', { ascending: true });
  if (error) { console.error(error); return; }
  allGifts = data || [];
  renderGifts();
  renderFilters();
}

function renderGifts() {
  const list = currentFilter === 'All' ? allGifts : allGifts.filter(g => g.category === currentFilter);
  const grid = document.getElementById('gifts-grid');

  if (list.length === 0) {
    grid.innerHTML = `<div class="empty-state"><div class="empty-icon">🌿</div><p>No items here yet — check back soon.</p></div>`;
    return;
  }

  grid.innerHTML = list.map(g => `
    <div class="gift-card ${g.purchased ? 'purchased' : ''}">
      <div class="gift-img">
        ${g.image_url ? `<img src="${g.image_url}" alt="${g.name}" onerror="this.parentElement.innerHTML='🎁'">` : '🎁'}
      </div>
      <div class="gift-body">
        <div class="gift-store">${g.store || ''}</div>
        <div class="gift-name">${g.name}</div>
        ${g.note ? `<div class="gift-note">"${g.note}"</div>` : ''}
        <div class="gift-footer">
          <div class="gift-price">${g.price || ''}</div>
          <div class="gift-actions">
            ${g.url ? `<a href="${g.url}" target="_blank" class="btn-link">View ↗</a>` : ''}
            ${!g.purchased ? `<button class="btn-claim" onclick="openClaimModal('${g.id}', '${(g.name || '').replace(/'/g,"\\'")}')">Claim</button>` : ''}
            ${adminUnlocked ? `<button class="btn-delete" onclick="deleteGift('${g.id}')">✕</button>` : ''}
          </div>
        </div>
      </div>
    </div>
  `).join('');
}

function renderFilters() {
  const cats = ['All', ...new Set(allGifts.map(g => g.category).filter(Boolean))];
  const row = document.getElementById('filter-row');
  row.innerHTML = cats.map(c => `
    <button class="filter-btn ${c === currentFilter ? 'active' : ''}" onclick="filterGifts('${c}', this)">${c}</button>
  `).join('');
}

function filterGifts(cat, btn) {
  currentFilter = cat;
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderGifts();
}

async function addGift() {
  const name = document.getElementById('gift-name').value.trim();
  if (!name) { showToast('Please enter an item name'); return; }

  const { error } = await db.from('gifts').insert({
    name,
    store: document.getElementById('gift-store').value.trim(),
    price: document.getElementById('gift-price').value.trim(),
    url: document.getElementById('gift-url').value.trim(),
    image_url: document.getElementById('gift-image').value.trim(),
    category: document.getElementById('gift-category').value,
    qty: parseInt(document.getElementById('gift-qty').value) || 1,
    note: document.getElementById('gift-note').value.trim(),
    purchased: false
  });

  if (error) { showToast('Error adding item'); console.error(error); return; }

  ['gift-name','gift-store','gift-price','gift-url','gift-image','gift-note'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('gift-qty').value = 1;
  showToast('Gift added!');
  await loadGifts();
}

async function deleteGift(id) {
  if (!confirm('Remove this item?')) return;
  await db.from('gifts').delete().eq('id', id);
  showToast('Item removed');
  await loadGifts();
}

// ─── CLAIM ────────────────────────────────────────────────────────────────────
function openClaimModal(id, name) {
  claimingId = id;
  document.getElementById('claim-modal-text').textContent = `"${name}" will be marked as claimed so other guests know it's taken.`;
  document.getElementById('claim-modal').classList.add('open');
}

function closeClaimModal() {
  document.getElementById('claim-modal').classList.remove('open');
  claimingId = null;
}

async function confirmClaim() {
  await db.from('gifts').update({ purchased: true }).eq('id', claimingId);
  closeClaimModal();
  showToast('Gift claimed! 🎉');
  await loadGifts();
}

// ─── FUNDS ────────────────────────────────────────────────────────────────────
async function loadFunds() {
  const { data, error } = await db.from('funds').select('*').order('created_at', { ascending: true });
  if (error) { console.error(error); return; }
  renderFunds(data || []);
}

function renderFunds(funds) {
  const grid = document.getElementById('cash-funds-grid');
  if (!funds || funds.length === 0) {
    grid.innerHTML = `<div class="empty-state"><div class="empty-icon">💛</div><p>No funds added yet.</p></div>`;
    return;
  }
  grid.innerHTML = funds.map(f => {
    const pct = f.goal ? Math.min(100, Math.round(((f.raised || 0) / f.goal) * 100)) : 0;
    return `
      <div class="cash-card">
        <div class="cash-icon">${f.icon || '💛'}</div>
        <h4>${f.name}</h4>
        <p>${f.description || ''}</p>
        ${f.goal ? `<div class="cash-goal">${pct}% of $${Number(f.goal).toLocaleString()} goal</div>
        <div class="progress-bar"><div class="progress-fill" style="width:${pct}%"></div></div>` : ''}
        <div style="display:flex; gap:10px; align-items:center;">
          ${f.link ? `<a href="${f.link}" target="_blank" class="btn-claim btn" style="text-decoration:none; padding:10px 20px; font-size:0.76rem; letter-spacing:0.12em; text-transform:uppercase;">Contribute</a>` : '<span style="font-size:0.8rem;color:#bbb;font-style:italic;">Link coming soon</span>'}
          ${adminUnlocked ? `<button class="btn-delete" onclick="deleteFund('${f.id}')">✕</button>` : ''}
        </div>
      </div>
    `;
  }).join('');
}

async function addFund() {
  const name = document.getElementById('fund-name').value.trim();
  if (!name) { showToast('Please enter a fund name'); return; }

  const { error } = await db.from('funds').insert({
    name,
    description: document.getElementById('fund-desc').value.trim(),
    goal: parseFloat(document.getElementById('fund-goal').value) || null,
    raised: 0,
    icon: document.getElementById('fund-icon').value.trim() || '💛',
    link: document.getElementById('fund-link').value.trim()
  });

  if (error) { showToast('Error adding fund'); console.error(error); return; }

  ['fund-name','fund-desc','fund-goal','fund-icon','fund-link'].forEach(id => document.getElementById(id).value = '');
  showToast('Fund added!');
  await loadFunds();
}

async function deleteFund(id) {
  if (!confirm('Remove this fund?')) return;
  await db.from('funds').delete().eq('id', id);
  showToast('Fund removed');
  await loadFunds();
}

// ─── TOAST ────────────────────────────────────────────────────────────────────
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3000);
}

// Close modals on overlay click
document.getElementById('claim-modal').addEventListener('click', function(e) { if (e.target === this) closeClaimModal(); });
document.getElementById('settings-overlay').addEventListener('click', function(e) { if (e.target === this) closeSettings(); });

init();
</script>
</body>
</html>
